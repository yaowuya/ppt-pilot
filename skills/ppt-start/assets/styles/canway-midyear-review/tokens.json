{
  "schema_version": 1,
  "id": "canway-midyear-review",
  "display_name": "嘉为年中总结风格",
  "colors": {
    "canvas": "#F5F8FC",
    "hero_dark": "#10233F",
    "brand_primary": "#156BFF",
    "title_accent": "#1E63FF",
    "sky": "#65B7F9",
    "ai_pilot": "#8866FD",
    "ink": "#0B1930",
    "text_secondary": "#52637B",
    "fact_surface": "#FFFFFF",
    "evidence_surface": "#EFF6FF",
    "pilot_surface": "#F7F5FF",
    "border": "#DCE9F8"
  },
  "typography": {
    "font_stack": ["Microsoft YaHei", "PingFang SC", "Arial", "sans-serif"],
    "slide_title": 40,
    "primary_proposition": 30,
    "section_title": 24,
    "body": 20,
    "support": 16,
    "micro_label": 14,
    "title_weight": 700,
    "emphasis_weight": 700,
    "body_weight": 400
  },
  "spacing": {
    "outer_margin": 64,
    "standard_gap": 24,
    "card_gap": 20,
    "compact_gap": 16,
