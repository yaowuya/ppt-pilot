{
  "schema_version": 2,
  "id": "jiawei-product",
  "display_name": "嘉为产品",
  "prompt_role": "product_manager",
  "colors": {
    "canvas": "#FFFFFF",
    "brand_primary": "#0B74E5",
    "deep_primary": "#0A5CC9",
    "highlight_blue": "#27B3FF",
    "light_blue": "#EAF5FF",
    "light_blue_2": "#D8EEFF",
    "border_blue": "#BFE3FF",
    "page_light_gray": "#F6F9FC",
    "title_ink": "#000000",
    "body_gray": "#4B5563",
    "muted_gray": "#6B7280",
    "connector_blue": "#60A5FA"
  },
  "typography": {
    "font_stack": ["Microsoft YaHei", "Source Han Sans", "sans-serif"],
    "page_title": 36,
    "section_title": 26,
    "module_label": 20,
    "body": 20,
    "caption": 14,
    "title_weight": 700,
    "section_weight": 600,
    "body_weight": 400,
    "label_weight": 500
  },
  "spacing": {
    "outer_margin": 64,
    "standard_gap": 24,
    "card_gap": 24,
    "card_padding": 24,
    "line_height": 1.4
  },
  "shape": {
    "button_radius": 8,
    "module_radius": 14,
    "card_radius": 16,
    "stroke_width": 1,
    "connector_width": 2
  },
  "composition": {
    "layout_family": "content_driven",
    "title_position": "top_left",
    "min_card_gap": 20,
    "no_english_title": true,
    "no_top_right_logo": true,
    "strict_brand_rules": true,
    "title_decoration": "black_blue_offset_squares",
    "surface_style": "sparse_enterprise",
    "content_focus": "current_and_next_actions",
    "layout_recipes": ["product_overview", "comparison", "process_milestone", "metrics_financial"]
  },
  "prompt_baseline": {
    "palette_roles": [
      { "token": "canvas", "role": "page_canvas", "use": "page_canvas" },
      { "token": "page_light_gray", "role": "page_canvas", "use": "optional_canvas" },
      { "token": "title_ink", "role": "headline", "use": "page_title" },
      { "token": "body_gray", "role": "body_text", "use": "body_copy" },
      { "token": "muted_gray", "role": "body_text", "use": "caption_text" },
      { "token": "brand_primary", "role": "primary_emphasis", "use": "module_emphasis" },
      { "token": "deep_primary", "role": "hierarchy_boundary", "use": "hierarchy_boundary" },
      { "token": "highlight_blue", "role": "selected_state", "use": "selected_state" },
      { "token": "light_blue", "role": "secondary_surface", "use": "weak_emphasis" },
      { "token": "light_blue_2", "role": "secondary_surface", "use": "geometric_support" },
      { "token": "border_blue", "role": "hierarchy_boundary", "use": "thin_border" },
      { "token": "connector_blue", "role": "secondary_relationship", "use": "flow_connector" }
    ],
    "font_stack": ["Microsoft YaHei", "Source Han Sans", "sans-serif"],
    "spacing_rhythm": {
      "outer_margin": 64,
      "standard_gap": 24,
      "card_gap": 24,
      "card_padding": 24,
      "line_height": 1.4
    },
    "shape_language": {
      "button_radius": 8,
      "module_radius": 14,
      "card_radius": 16,
      "stroke_width": 1,
      "connector_width": 2
    },
    "composition_rules": {
      "layout_family": "content_driven",
      "title_position": "top_left",
      "min_card_gap": 20,
      "no_english_title": true,
      "no_top_right_logo": true,
      "strict_brand_rules": true,
      "title_decoration": "black_blue_offset_squares",
      "surface_style": "sparse_enterprise",
      "content_focus": "current_and_next_actions",
      "layout_recipes": ["product_overview", "comparison", "process_milestone", "metrics_financial"]
    },
    "prohibited_motifs": [
      "background_image_or_texture",
      "frosted_glass",
      "high_saturation_blue_blocks",
      "equal_weight_card_wall",
      "forced_metric_cards",
      "literal_page_conclusion",
      "english_title_translation",
      "top_right_logo",
      "connector_through_text"
    ]
  }
}
