{
  "schema_version": 2,
  "id": "jiawei-product",
  "display_name": "嘉为产品",
  "colors": {
    "canvas": "#FFFFFF",
    "brand_primary": "#0B74E5",
    "deep_primary": "#0A5CC9",
    "highlight_blue": "#27B3FF",
    "light_blue": "#EAF5FF",
    "light_blue_2": "#D8EEFF",
    "border_blue": "#BFE3FF",
    "page_light_gray": "#F6F9FC",
    "title_ink": "#111827",
    "body_gray": "#4B5563",
    "muted_gray": "#6B7280"
  },
  "typography": {
    "font_stack": ["Source Han Sans", "Microsoft YaHei", "sans-serif"],
    "page_title": 36,
    "section_title": 20,
    "module_label": 15,
    "body": 13,
    "caption": 11,
    "title_weight": 700,
    "section_weight": 600,
    "body_weight": 400,
    "label_weight": 500
  },
  "spacing": {
    "outer_margin": 64,
    "card_gap": 20,
    "page_padding": 12,
    "line_height": 1.4
  },
  "shape": {
    "button_radius": 8,
    "module_radius": 14,
    "card_radius": 16,
    "stroke_width": 1,
    "shadow_offset_y": 4,
    "shadow_blur": 12
  },
  "composition": {
    "tone": "产品经理视角，商务+科技+简约，蓝色科技风，弱阴影，圆角卡片，信息密度中等",
    "title_position": "top-left",
    "title_font_weight": 700,
    "title_size": "34-38px",
    "title_color": "#000000",
    "title_decoration": "黑蓝错位方块（左上黑、右下蓝）",
    "no_english_title": true,
    "no_top_right_logo": true
  },
  "prompt_baseline": {
    "palette_roles": [
      { "token": "brand_primary", "role": "标题条/主模块条/关键按钮", "use": "主品牌蓝，用于标题条、主模块条、关键按钮" },
      { "token": "deep_primary", "role": "渐变深端/强调", "use": "用于蓝色渐变的深端或强调" },
      { "token": "highlight_blue", "role": "渐变浅端/高光", "use": "用于蓝色渐变的浅端或发光感" },
      { "token": "light_blue", "role": "卡片底/弱强调区", "use": "用于卡片底、弱强调区、右侧卖点卡底色" },
      { "token": "title_ink", "role": "大标题文字", "use": "用于页面主标题/深灰正文" }
    ],
    "font_stack": ["Source Han Sans", "Microsoft YaHei", "sans-serif"],
    "spacing_rhythm": {
      "outer_margin": 64,
      "card_gap": 20,
      "page_padding": 12,
      "line_height": 1.4
    },
    "shape_language": {
      "button_radius": 8,
      "module_radius": 14,
      "card_radius": 16,
      "stroke_width": 1,
      "shadow": "0 4 12 rgba(15,23,42,0.08)"
    },
    "composition_rules": {
      "tone": "产品经理视角，商务+科技+简约，蓝色科技风，弱阴影，圆角卡片",
      "layout_hint": "顶部标题栏 + 中部主流程/模块区 + 底部底座区 + 右侧卖点说明栏（左 2/3 + 右 1/3）",
      "min_card_gap": 20
    },
    "prohibited_motifs": [
      "背景照片或纹理",
      "毛玻璃（backdrop-filter）",
      "大量高饱和蓝色块状元素",
      "等权卡片墙",
      "强行拆分成数据卡片",
      "页面结论四字",
      "标题英文翻译",
      "右上角 logo 或图标",
      "穿过文字的连接线"
    ],
    "layout_preferences": [
      { "when": "产品能力概览页", "structure": "顶部标题栏 + 中部主流程/模块区 + 底部平台承载区 + 右侧卖点说明栏（左 2/3 + 右 1/3）" },
      { "when": "对比页", "structure": "不对称双栏，主卡显著大于次卡" },
      { "when": "流程/里程碑页", "structure": "横向流程 + 箭头引导；上方主能力条，中间步骤按钮，下方管理模块矩阵" }
    ],
    "structure_rules": [
      "先提纯为金字塔结构（1 主标题 + 2-5 分论点），再选择布局",
      "卡片之间至少 20px 间距，页面边缘保留合理留白",
      "指标完成度优先用简洁表格表达，不拆成多个数据卡片",
      "重点放在“当前重点”与“下一步要做的事”，无需页面结论四个字",
      "页面标题固定左上，右侧不放置 logo/图标"
    ],
    "title_spec": {
      "position": "top-left",
      "font_weight": 700,
      "size": "34-38px",
      "color": "#000000",
      "decoration": "黑蓝错位方块（左黑右蓝）",
      "no_english": true,
      "no_top_right_logo": true
    },
    "tone_skew": "产品经理视角，商务+科技+简约，蓝色科技风，弱阴影，圆角卡片，大留白、浅色底、少量蓝色强调"
  }
}
