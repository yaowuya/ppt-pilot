{
  "schema_version": 2,
  "id": "minimal-business",
  "display_name": "极简商务",
  "colors": {
    "background": "#FFFFFF",
    "surface": "#F2F6F8",
    "text": "#17212B",
    "muted": "#5E6B76",
    "dominant": "#163B52",
    "support": "#D8E7ED",
    "accent": "#E06B45"
  },
  "typography": {
    "font_stack": ["Arial", "Microsoft YaHei", "PingFang SC", "sans-serif"],
    "slide_title": 40,
    "body": 20,
    "micro_label": 14,
    "title_weight": 700,
    "body_weight": 400
  },
  "spacing": {
    "outer_margin": 64,
    "standard_gap": 24,
    "card_padding": 24
  },
  "shape": {
    "corner_radius": 12,
    "stroke_width": 1.5
  },
  "composition": {
    "layout_family": "content_driven",
    "card_coverage": "20%-40%",
    "primary_secondary_ratio": 1.5
  },
  "prompt_baseline": {
    "palette_roles": [
      {"token": "dominant", "role": "primary_emphasis", "use": "title_or_key_emphasis"},
      {"token": "accent", "role": "action_or_metric", "use": "metric_or_action"},
      {"token": "support", "role": "secondary_surface", "use": "secondary_surface"}
    ],
    "font_stack": ["Arial", "Microsoft YaHei", "PingFang SC", "sans-serif"],
    "spacing_rhythm": {"outer_margin": 64, "standard_gap": 24, "card_padding": 24},
    "shape_language": {"corner_radius": 12, "stroke_width": 1.5},
    "composition_rules": {
      "layout_family": "content_driven",
      "card_coverage": "20%-40%",
      "primary_secondary_ratio": 1.5
    },
    "prohibited_motifs": ["equal_weight_card_wall", "high_saturation_multicolor", "background_image_or_texture"]
  }
}
