{
  "schema_version": 2,
  "id": "bold-editorial",
  "display_name": "强调编辑",
  "colors": {
    "background": "#FFFDF8",
    "surface": "#F1E8D8",
    "text": "#201B18",
    "muted": "#6D625A",
    "dominant": "#8C1C3A",
    "support": "#D9B7A6",
    "accent": "#E99A2E"
  },
  "typography": {
    "font_stack": [
      "Cambria",
      "Microsoft YaHei",
      "PingFang SC",
      "serif"
    ],
    "title_min": 42,
    "body_min": 20,
    "footnote_min": 14,
    "title_weight": 700,
    "body_weight": 400
  },
  "spacing": {
    "outer_margin": 64,
    "standard_gap": 24,
    "card_padding": 28
  },
  "shape": {
    "corner_radius": 8,
    "stroke_width": 2
  },
  "composition": {},
  "prompt_baseline": {
    "palette_roles": [
      {
        "token": "dominant",
        "role": "主导标题色",
        "use": "标题、强调"
      },
      {
        "token": "accent",
        "role": "强调色",
        "use": "数据/行动点"
      },
      {
        "token": "support",
        "role": "支持面",
        "use": "次级表面"
      }
    ],
    "font_stack": [
      "Cambria",
      "Microsoft YaHei",
      "PingFang SC",
      "serif"
    ],
    "spacing_rhythm": {
      "outer_margin": 64,
      "standard_gap": 24,
      "card_padding": 28
    },
    "shape_language": {
      "corner_radius": 8,
      "stroke_width": 2
    },
    "composition_rules": {},
    "prohibited_motifs": [
      "冷色数据大屏感",
      "纯白无编辑感",
      "过度圆角"
    ]
  }
}
