{
  "schema_version": 2,
  "id": "bold-editorial",
  "display_name": "强调编辑",
  "colors": {
    "background": "#FFFDF8",
    "surface": "#F1E8D8",
    "text": "#201B18",
    "muted": "#6D625A",
    "dominant": "#8C1C3A",
    "support": "#D9B7A6",
    "accent": "#E99A2E"
  },
  "typography": {
    "font_stack": [
      "Cambria",
      "Microsoft YaHei",
      "PingFang SC",
      "serif"
    ],
    "slide_title": 42,
    "body": 20,
    "micro_label": 14,
    "title_weight": 700,
    "body_weight": 400
  },
  "spacing": {
    "outer_margin": 64,
    "standard_gap": 24,
    "card_padding": 28
  },
  "shape": {
    "corner_radius": 8,
    "stroke_width": 2
  },
  "composition": {
    "layout_family": "balanced_editorial",
    "card_coverage": "30%-50%",
    "primary_secondary_ratio": 2
  },
  "prompt_baseline": {
    "palette_roles": [
      {
        "token": "dominant",
        "role": "headline",
        "use": "title_or_key_emphasis"
      },
      {
        "token": "accent",
        "role": "action_or_metric",
        "use": "metric_or_action"
      },
      {
        "token": "support",
        "role": "secondary_surface",
        "use": "secondary_surface"
      }
    ],
    "font_stack": [
      "Cambria",
      "Microsoft YaHei",
      "PingFang SC",
      "serif"
    ],
    "spacing_rhythm": {
      "outer_margin": 64,
      "standard_gap": 24,
      "card_padding": 28
    },
    "shape_language": {
      "corner_radius": 8,
      "stroke_width": 2
    },
    "composition_rules": {
      "layout_family": "balanced_editorial",
      "card_coverage": "30%-50%",
      "primary_secondary_ratio": 2
    },
    "prohibited_motifs": [
      "cold_dashboard",
      "plain_white_editorial_loss",
      "excessive_rounding"
    ]
  }
}
